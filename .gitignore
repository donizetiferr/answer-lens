*.local.*
CHECKPOINT.local.md
# Raw logs, browser exports and host-specific Studio receipts stay on the VPS.
/evidence/
/media/demo/
/media/demo-v2/
# Preserve the pre-review screenshots without publishing stale evidence.
/media/*.png
/scripts/make-demo-project.py
# Publish only the four captures inspected in the finishing review.
/media/review-v2/*
!/media/review-v2/desktop-blind.png
!/media/review-v2/desktop-result.png
!/media/review-v2/mobile-ratings.png
!/media/review-v2/mobile-result.png

# The README demo output is generated locally, not a source asset.
/result.json

# Never publish local credentials, databases, browser state or operational logs.
.state/
.ssh/
.aws/
*.pem
*.key
*.p12
*.pfx
*.sqlite*
*.db
*.sql
*.log
